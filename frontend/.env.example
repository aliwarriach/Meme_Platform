EXPO_PUBLIC_API_URL=http://127.0.0.1:6001

# "Sign in with Google" (SecurityFeatures.md F-7) — separate OAuth Client IDs per
# platform, from the same Google Cloud Console project as the backend's Gmail sender
# (but a different, non-"Desktop app" credential type per platform). Leave unset in dev;
# the button just won't complete a real sign-in until these are configured. See
# .claude/memory/hardening.md for the Google Cloud Console setup steps.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

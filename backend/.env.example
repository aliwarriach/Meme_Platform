ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/meme_platform
REDIS_URL=redis://localhost:6379/0
# The app refuses to start unless this is a real secret (SecurityFeatures.md F-8) — the
# placeholder below is deliberately short so copying it verbatim fails loudly instead of
# silently working. Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=REPLACE_ME
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional — email OTP verification (SecurityFeatures.md F-1). Leave unset in dev; the
# app starts fine without them, /auth/email/verify/request just fails until configured.
# See .claude/memory/hardening.md for how to obtain GOOGLE_OAUTH_REFRESH_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Optional — "Sign in with Google" (SecurityFeatures.md F-7). Comma-separated list of
# accepted ID-token audiences (one per platform client: iOS, Android, Web) — a *different*
# credential set from GOOGLE_OAUTH_CLIENT_ID above. See .claude/memory/hardening.md.
GOOGLE_SIGNIN_CLIENT_IDS=
